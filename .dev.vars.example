# Used by wrangler locally and by the Deploy to Cloudflare button as secret prompts.
JWT_SECRET=replace-with-a-long-random-jwt-secret
KEY_HMAC_SECRET=replace-with-a-long-random-hmac-secret

# Optional fallback only. Prefer the admin 设置 page after login.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
